generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  passwordHash  String
  name          String
  avatar        String?
  systemRole    String            @default("USER")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  workspaces    WorkspaceMember[]
  createdEvents Event[]           @relation("EventCreator")
  assignedTasks Task[]            @relation("TaskAssignee")
  sessions      Session[]
  notifications Notification[]
  activityLogs  ActivityLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  ownerId   String
  currency  String            @default("INR")
  locale    String            @default("en-IN")
  timezone  String            @default("Asia/Kolkata")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  members   WorkspaceMember[]
  events    Event[]
  vendors   Vendor[]
  invites   Invitation[]
  logs      ActivityLog[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("EDITOR") // OWNER, ADMIN, EDITOR, VIEWER
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        String    @default("EDITOR")
  token       String    @unique
  status      String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Event {
  id                 String           @id @default(cuid())
  workspaceId        String
  creatorId          String
  title              String
  slug               String
  type               String           @default("WEDDING") // WEDDING, BIRTHDAY, COMMUNITY, CORPORATE, WORKSHOP, CUSTOM
  status             String           @default("PLANNING") // PLANNING, CONFIRMED, COMPLETED, ARCHIVED
  startDate          DateTime
  endDate            DateTime?
  location           String
  guestCount         Int              @default(50)
  budgetCeiling      Float            @default(100000)
  currency           String           @default("INR")
  theme              String?
  formality          String?          @default("Semi-formal")
  dietaryNotes       String?
  accessibilityNotes String?
  notes              String?
  coverImage         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator            User             @relation("EventCreator", fields: [creatorId], references: [id])
  categories         BudgetCategory[]
  expenses           Expense[]
  tasks              Task[]
  vendors            Vendor[]
  guests             Guest[]
  ideas              Idea[]
  aiPlans            AIPlan[]
  activityLogs       ActivityLog[]

  @@unique([workspaceId, slug])
}

model BudgetCategory {
  id              String    @id @default(cuid())
  eventId         String
  name            String
  allocatedAmount Float     @default(0)
  color           String    @default("#6366f1")
  icon            String?   @default("wallet")
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  expenses        Expense[]

  @@unique([eventId, name])
}

model Expense {
  id          String          @id @default(cuid())
  eventId     String
  categoryId  String
  title       String
  amount      Float
  status      String          @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED
  paymentDate DateTime?
  receiptUrl  String?
  vendorId    String?
  notes       String?
  isEstimated Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category    BudgetCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendor      Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
}

model Task {
  id             String           @id @default(cuid())
  eventId        String
  title          String
  description    String?
  status         String           @default("TODO") // TODO, IN_PROGRESS, BLOCKED, COMPLETED
  priority       String           @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate        DateTime?
  category       String?          @default("General")
  assignedToId   String?
  estimatedHours Float?
  order          Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedTo     User?            @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dependencies   TaskDependency[] @relation("TaskDependencies")
  dependentOnMe  TaskDependency[] @relation("TaskPrerequisites")
}

model TaskDependency {
  id          String @id @default(cuid())
  taskId      String
  dependsOnId String

  task        Task   @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("TaskPrerequisites", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

model Vendor {
  id            String        @id @default(cuid())
  eventId       String
  workspaceId   String
  name          String
  category      String
  contactName   String?
  email         String?
  phone         String?
  website       String?
  address       String?
  quotedAmount  Float?
  bookingStatus String        @default("TO_RESEARCH") // TO_RESEARCH, CONTACTED, QUOTE_RECEIVED, SHORTLISTED, BOOKED, CANCELLED
  paymentStatus String        @default("NOT_DUE") // NOT_DUE, DEPOSIT_DUE, PARTIALLY_PAID, PAID, REFUNDED
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenses      Expense[]
  quotes        VendorQuote[]
}

model VendorQuote {
  id         String    @id @default(cuid())
  vendorId   String
  amount     Float
  currency   String    @default("INR")
  validUntil DateTime?
  details    String?
  createdAt  DateTime  @default(now())

  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Guest {
  id             String   @id @default(cuid())
  eventId        String
  name           String
  email          String?
  phone          String?
  group          String   @default("GENERAL") // FAMILY, FRIENDS, VIP, GENERAL, COLLEAGUES
  rsvpStatus     String   @default("NO_REPLY") // ATTENDING, DECLINED, TENTATIVE, NO_REPLY
  plusOnes       Int      @default(0)
  dietaryNeeds   String?
  notes          String?
  invitationSent Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Idea {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String
  category    String   @default("Theme") // Theme, Decor, Menu, Activity, Favor
  impact      String   @default("Medium") // High, Medium, Low
  status      String   @default("PROPOSED") // PROPOSED, ACCEPTED, REJECTED, IMPLEMENTED
  resources   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, ALERT
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String     @id @default(cuid())
  workspaceId String
  eventId     String?
  userId      String?
  action      String
  details     String?
  createdAt   DateTime   @default(now())

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event       Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AIPlan {
  id          String    @id @default(cuid())
  eventId     String
  summary     String
  rawJson     String
  approved    Boolean   @default(false)
  appliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
}
