# Database Configuration (SQLite for local zero-dependency dev; PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Authentication Secrets
JWT_SECRET="replace-with-a-secure-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenAI Configuration (Optional - intelligent multi-agent deterministic fallback is active if empty)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Application Settings
NODE_ENV="development"
PORT=3000
